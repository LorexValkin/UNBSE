  "patchSet": {
    "id": "unbse-ue4ss-v1",
    "baseCommit": "68dd45cb5630bd7745310c6630b19c14345176a2",
    "directory": "ue4ss/patches",
    "status": "production-release-reproducible-runtime",
    "patches": [
      {
        "relativePath": "ue4ss/patches/0001-add-unbse-external-mod.patch",
        "sha256": "640E853526731A5A7A34162B79552E386C3671B57C1805124F464CEA71CA8BF3",
        "purpose": "Build UNBSE inside the pinned UE4SS graph so compiler configuration and CRT match exactly.",
        "expectedChangedPaths": [
          "CMakeLists.txt"
        ]
      },
      {
        "relativePath": "ue4ss/patches/0002-fix-msvc-special-invalid-ptr-constexpr.patch",
        "sha256": "5C47A792A29F8030B3380E11B7B47F229A69BCB6FFADF0B3940982D22EC9788B",
        "purpose": "Apply the same non-constexpr runtime sentinel form present in later upstream source so pinned UE4SS compiles with MSVC 14.44.",
        "expectedChangedPaths": [
          "deps/first/LuaMadeSimple/include/LuaMadeSimple/LuaObject.hpp"
        ]
      },
      {
        "relativePath": "ue4ss/patches/0004-log-cpp-mod-lifecycle-boundary.patch",
        "sha256": "C74E4F3E53EBAADC41089619CB9F0FFD7263CEAF661C337E5B48328CCA736DC4",
        "purpose": "Log native mod lifecycle boundaries so startup failures identify the responsible module.",
        "expectedChangedPaths": [
          "UE4SS/src/Mod/CppMod.cpp"
        ]
      },
      {
        "relativePath": "ue4ss/patches/0005-make-shipping-ue4ss-reproducible.patch",
        "sha256": "63A719DB354EC045534975FE53AC50308600E5EF1B25F39230F3FD5AB1F6E65A",
        "purpose": "Link the Shipping UE4SS host with /Brepro so identical pinned source, toolchain, and configuration produce a byte-identical runtime DLL while preserving a build-specific PDB for crash diagnosis.",
        "expectedChangedPaths": [
          "UE4SS/CMakeLists.txt"
        ]
      },
      {
        "relativePath": "ue4ss/patches/0006-start-bundled-unbse-mods-without-manager-markers.patch",
        "sha256": "248B86E267E0FA7014EA51DAEB2616D40178E6D885B4D2A2FD759EBC364F9E7E",
        "purpose": "Start the bundled UNBSE foundation components deterministically even when a mod manager withholds enabled.txt or rewrites mods.txt.",
        "expectedChangedPaths": [
          "UE4SS/src/UE4SSProgram.cpp"
        ]
      },
      {
        "relativePath": "ue4ss/patches/0007-support-legacy-cpp-abi-and-consoleutils.patch",
        "sha256": "55A51A46FD06B6D8F7D406E64532EBF6E79881A935D62921EA8A834F4A3F04A9",
        "purpose": "Classify supported C++ mod ABI profiles from validated vtable shape, dispatch the legacy 11-slot callback surface without module-name gates, summarize adapted legacy mods once per bulk startup, and retain the exact ConsoleUtils 1.1 EngineTick workaround.",
        "expectedChangedPaths": [
          "UE4SS/src/Mod/CppMod.cpp",
          "deps/first/SinglePassSigScanner/include/SigScanner/SinglePassSigScanner.hpp",
          "deps/first/SinglePassSigScanner/src/SinglePassSigScanner.cpp"
        ]
      },
      {
        "relativePath": "ue4ss/patches/0008-adapt-legacy-lua-execute-console-command.patch",
        "sha256": "135BD91DAB4F13976F04FC1CEC0BCF187F199148CEBCFE26573D9AB8A71BD3D3",
        "purpose": "Adapt the legacy three-argument Lua call shape only for KismetSystemLibrary.ExecuteConsoleCommand when the current runtime reflects four parameters, preserving strict arity checks for every other UFunction.",
        "expectedChangedPaths": [
          "UE4SS/src/LuaType/LuaUObject.cpp"
        ]
      }
    ]
  },
