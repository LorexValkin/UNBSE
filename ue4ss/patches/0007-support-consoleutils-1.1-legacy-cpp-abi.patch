+
+        __declspec(noinline) auto console_utils_game_thread_probe(uint64_t first, uint64_t second, uint64_t third) -> uint64_t
+        {
+            volatile uint64_t values[]{first, second, third, 0};
+            values[3] = values[0] + values[1] + values[2];
+            return values[3];
+        }
+
+        auto uses_legacy_cpp_mod_abi(StringViewType mod_name, const CppUserModBase* mod) -> bool
+        {
+            // ConsoleUtils 1.1 was built against the August 2025 C++ mod ABI.
+            // Later overloads changed MSVC's vtable grouping, shifting callbacks
+            // that followed the Lua callback overloads.
+            return mod && mod_name == STR("ConsoleUtils") && mod->ModVersion == STR("1.1");
+        }
+
+        auto fire_legacy_on_lua_start_with_mod_name(CppUserModBase* mod,
+                                                    StringViewType mod_name,
+                                                    LuaMadeSimple::Lua& lua,
+                                                    LuaMadeSimple::Lua& main_lua,
+                                                    LuaMadeSimple::Lua& async_lua,
+                                                    std::vector<LuaMadeSimple::Lua*>& hook_luas) -> void
+        {
+            using Callback = void (*)(CppUserModBase*,
+                                      StringViewType,
+                                      LuaMadeSimple::Lua&,
+                                      LuaMadeSimple::Lua&,
+                                      LuaMadeSimple::Lua&,
+                                      std::vector<LuaMadeSimple::Lua*>&);
+
+            auto vtable = *reinterpret_cast<void***>(mod);
+            auto callback = reinterpret_cast<Callback>(vtable[legacy_on_lua_start_with_mod_name_vtable_index]);
+            callback(mod, mod_name, lua, main_lua, async_lua, hook_luas);
+        }
+
+        auto arm_console_utils_game_thread_probe() -> void
+        {
+            console_utils_game_thread_probe_pending.store(true, std::memory_order_release);
+            std::call_once(console_utils_game_thread_probe_registration, [] {
+                Unreal::Hook::RegisterEngineTickPreCallback(
+                        []([[maybe_unused]] auto& callback_iteration_data,
+                           [[maybe_unused]] auto* context,
+                           [[maybe_unused]] float delta_seconds,
+                           [[maybe_unused]] bool idle) {
+                            if (console_utils_game_thread_probe_pending.exchange(false, std::memory_order_acq_rel))
+                            {
+                                console_utils_game_thread_probe(0, 0, 0);
+                                Output::send(STR("[UE4SS.ConsoleUtilsCompat] event=game-thread-probe phase=complete\n"));
+                            }
+                        },
+                        {false, false, STR("UNBSE"), STR("ConsoleUtilsCompat")});
+            });
+        }
+    }
