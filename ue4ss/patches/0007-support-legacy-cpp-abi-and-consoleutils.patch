+        auto readable_region(const void* address, size_t bytes) -> bool
+        {
+            if (!address || bytes == 0)
+            {
+                return false;
+            }
+
+            MEMORY_BASIC_INFORMATION info{};
+            if (VirtualQuery(address, &info, sizeof(info)) != sizeof(info) ||
+                info.State != MEM_COMMIT || (info.Protect & (PAGE_GUARD | PAGE_NOACCESS)) != 0)
+            {
+                return false;
+            }
+
+            const auto start = reinterpret_cast<uintptr_t>(address);
+            const auto end = start + bytes;
+            const auto region_start = reinterpret_cast<uintptr_t>(info.BaseAddress);
+            const auto region_end = region_start + info.RegionSize;
+            return end >= start && start >= region_start && end <= region_end;
+        }
+
+        auto executable_address(const void* address) -> bool
+        {
+            if (!address)
+            {
+                return false;
+            }
+
+            MEMORY_BASIC_INFORMATION info{};
+            if (VirtualQuery(address, &info, sizeof(info)) != sizeof(info) ||
+                info.State != MEM_COMMIT || (info.Protect & PAGE_GUARD) != 0)
+            {
+                return false;
+            }
+
+            switch (info.Protect & 0xff)
+            {
+            case PAGE_EXECUTE:
+            case PAGE_EXECUTE_READ:
+            case PAGE_EXECUTE_READWRITE:
+            case PAGE_EXECUTE_WRITECOPY:
+                return true;
+            default:
+                return false;
+            }
+        }
+
+        auto executable_vtable_prefix(void* const* vtable, size_t slot_count) -> bool
+        {
+            if (!readable_region(vtable, slot_count * sizeof(*vtable)))
+            {
+                return false;
+            }
+            for (size_t index = 0; index < slot_count; ++index)
+            {
+                if (!executable_address(vtable[index]))
+                {
+                    return false;
+                }
+            }
+            return true;
+        }
+
+        auto cpp_mod_abi_profile(const CppUserModBase* mod) -> ECppModAbiProfile
+        {
+            if (!readable_region(mod, sizeof(void*)))
+            {
+                return ECppModAbiProfile::Unknown;
+            }
+
+            auto vtable = *reinterpret_cast<void* const* const*>(mod);
+            if (!executable_vtable_prefix(vtable, legacy_cpp_mod_vtable_slot_count))
+            {
+                return ECppModAbiProfile::Unknown;
+            }
+            if (executable_vtable_prefix(vtable, current_cpp_mod_vtable_slot_count))
+            {
+                return ECppModAbiProfile::Current;
+            }
+            return ECppModAbiProfile::LegacyVectorCallbacks;
+        }
+
+        using LegacyLuaCallback = void (*)(CppUserModBase*,
